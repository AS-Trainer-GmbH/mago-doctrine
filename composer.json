{
    "name": "gimmickmedia/mago-doctrine",
    "description": "Doctrine ORM analyzer extension for Mago",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "carthage-software/mago": "^1.59",
        "doctrine/orm": "^2.15 || ^3.0"
    },
    "autoload": {
